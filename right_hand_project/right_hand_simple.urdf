  <joint name="left_index_0" type="revolute">
    <parent link="palm"/>
    <child link="left_index_link_0"/>
    <origin xyz="-0.03 0 0.055" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="1" velocity="1"/>
