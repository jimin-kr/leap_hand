    <parent link="left_thumb_link_2"/>
    <child link="left_thumb_link_3"/>
    <origin xyz="-0.022 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="1" velocity="1"/>
  </joint>

  <!-- index -->
