<?xml version="1.0"?>
<robot name="left_hand_simple">

  <link name="palm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.03 0.10"/>
      </geometry>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
  </link>

  <!-- thumb -->
  <link name="left_thumb_link_0"><visual><geometry><box size="0.025 0.015 0.015"/></geometry></visual></link>
  <joint name="left_thumb_0" type="revolute">
    <parent link="palm"/>
    <child link="left_thumb_link_0"/>
    <origin xyz="-0.035 -0.02 0.025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="1" velocity="1"/>
  </joint>

  <link name="left_thumb_link_1"><visual><geometry><box size="0.025 0.012 0.012"/></geometry></visual></link>
  <joint name="left_thumb_1" type="revolute">
    <parent link="left_thumb_link_0"/>
    <child link="left_thumb_link_1"/>
    <origin xyz="-0.025 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="1" velocity="1"/>
  </joint>

  <link name="left_thumb_link_2"><visual><geometry><box size="0.022 0.010 0.010"/></geometry></visual></link>
